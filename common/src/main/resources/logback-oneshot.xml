<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback config used ONLY under the `oneshot` Spring profile (referenced via
  `logging.config: classpath:logback-oneshot.xml` in each service's application-oneshot.yaml).

  Purpose: route ALL application + Spring startup logging to System.err so that stdout is reserved
  exclusively for machine-readable output — specifically the `--mode list-scenarios` GitHub Actions
  dynamic-matrix JSON, which must be the ONLY thing on stdout. The normal (no-profile) always-on
  Kafka path never loads this file and keeps Spring Boot's default stdout console logging.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
