# .env.example — copy to .env at DEPLOY_PATH on your server and fill in values.
# This file documents every variable that docker-compose.prod.yml reads.
# Never commit the real .env file to source control.

# ── Container registry ────────────────────────────────────────────────────────
# GitHub org or user that owns the GHCR packages (no trailing slash).
# Example: GHCR_ORG=acme-corp  →  images pull from ghcr.io/acme-corp/qa-isystem/...
GHCR_ORG=

# ── Image tags (optional — defaults to "latest") ─────────────────────────────
# The CD workflow overwrites these with the SHA-based tag from the build.
PR_SERVICE_TAG=latest
IMPACT_SERVICE_TAG=latest
STRATEGY_SERVICE_TAG=latest

# ── strategy-service: target test repository ──────────────────────────────────
# The repository that strategy-service clones for coverage context AND creates
# BDD / test-code PRs in.
#
# For LOCAL DEVELOPMENT with IntelliJ GitHub auth:
#   Leave TARGET_REPO_TOKEN blank.  GitHubService will automatically call
#   "git credential fill" which reads your token from osxkeychain — the same
#   store IntelliJ writes to when you connect it to GitHub.
#   No extra setup needed as long as IntelliJ is already logged in.
#
# For CI / PRODUCTION:
#   Set TARGET_REPO_TOKEN to a PAT with "repo" scope.
TARGET_REPO_URL=
TARGET_REPO_TOKEN=
TARGET_REPO_USERNAME=

# ── impact-service: AI last-resort evaluator ─────────────────────────────────
# Set AIQA_AI_ENABLED=true and provide an API key to enable AI refinement.
AIQA_AI_ENABLED=false
AIQA_AI_API_KEY=
AIQA_AI_MODEL=gpt-4o-mini

# ── strategy-service: GitHub webhook ─────────────────────────────────────────
# HMAC-SHA256 secret set in GitHub Repository Settings → Webhooks.
# The strategy-service uses this to verify that webhook events really came from GitHub.
# Leave blank in local dev (signature check is skipped with a warning).
GITHUB_WEBHOOK_SECRET=

# ── Security: admin API key (strategy-service) ───────────────────────────────
# Protects POST /api/strategy/approve-bdd, POST /api/strategy/refresh-context,
# and GET /api/strategy/pending-bdd.
# Generate a key:  openssl rand -hex 32
# Leave blank in local dev to skip the check (a warning is logged).
AIQA_ADMIN_KEY=

# ── Security: require webhook HMAC signature in production ───────────────────
# Set to "true" in production. "false" only for local dev without ngrok.
GITHUB_WEBHOOK_REQUIRE_SECRET=true

# ── AI provider — Copilot CLI (only supported provider) ──────────────────────
# No token env var needed — gh CLI manages credentials via OS keychain.
# Prerequisites: brew install gh && gh auth login
# Optional overrides:
# GH_CLI_PATH=/usr/local/bin/gh    # if 'gh' is not on PATH
# COPILOT_CLI_MODEL=claude-sonnet-4-5

# ── Kafka (production) ────────────────────────────────────────────────────────
# Hostname or IP that Kafka advertises to clients outside the Docker network.
KAFKA_HOST=localhost
